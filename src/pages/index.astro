---
import Layout from "../layouts/Layout.astro";
---
<Layout>
	<div class="home">
		<div class="text">
			<h1 class="title">Riley Sherlock</h1>
			<div class="subtitle">
				full stack web developer
			</div>
		</div>
		<div class="icon"></div>
	</div>

</Layout>

<style>
	.home {
		display: grid;
		grid-template-columns: 1fr min-content;
		margin: auto;
		width: min-content;
		height: min-content;
		gap: 16px;
	}

	.text {
		align-self: flex-start;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.title {
		white-space: nowrap;
		align-self: flex-start;
	}

	.subtitle {
		white-space: nowrap;
	}

	.icon {
		background-color: aqua;
		width: 256px;
		height: 256px;
	}
</style>