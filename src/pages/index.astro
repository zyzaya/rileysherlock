---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import homeImage from "../assets/home_image.png";
---
<Layout>
	<div class="home">
		<div class="text">
			<h1 class="title">Riley Sherlock</h1>
			<div class="subtitle">
				full-stack web developer
			</div>
		</div>
		<Image src={homeImage} alt="A stylistic representation of Riley Sherlock" height="512" loading="eager"}/>
	</div>

</Layout>

<style>
	h1 {
		color: var(--header);
	}
	
	.home {
		display: flex;
		flex-wrap: wrap;
		place-content: center;
		margin: auto;
		max-width: var(--max-width);
		height: min-content;
		gap: 16px;
	}

	.text {
		align-self: flex-start;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.title {
		white-space: nowrap;
		align-self: flex-start;
	}

	.subtitle {
		white-space: nowrap;
	}

	.icon {
		background-color: aqua;
		width: 256px;
		height: 256px;
	}
</style>