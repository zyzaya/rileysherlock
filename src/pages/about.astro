---
import Layout from "../layouts/Layout.astro";

---
<Layout>
    <div class="about">
        <h1 class="title">About Me</h1>
        <div class="description">
            Web developer with hands-on experience building web applications, interactive frontends, database-backed features, and automated tests. Familiar with Ruby on Rails, React, JavaScript, and modern development tools, with an interest in writing maintainable, well-tested code.
        </div>
        <div class="skills">
            <h2>Skills</h2>
            <span>git</span>
            <span>CSS</span>
            <span>HTML</span>
            <span>JavaScript</span>
            <span>TypeScript</span>
            <span>React</span>
            <span>SQL</span>
            <span>Ruby</span>
            <span>Ruby on Rails</span>
            <span>Stimulus</span>
            <span>Capybara</span>
            <span>Jest</span>
            <span>Minitest</span>
            <span>Rspec</span>
        </div>
    </div>
    
</Layout>

<style>
    .about {
        display: grid;
        grid-template-rows: 1fr min-content;
        gap: 8px;
    }
</style>