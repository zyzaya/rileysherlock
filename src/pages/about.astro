---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const skills = (await getCollection("skills")).sort(
    (a, b) => a.id.localeCompare(b.id)
)
const size = 24
---
<Layout>
    <div class="about">
        <h1 class="title">Bio</h1>
        <div class="description">
            Web developer with hands-on experience building web applications, interactive frontends, database-backed features, and automated tests. Familiar with Ruby on Rails, React, JavaScript, and modern development tools, with an interest in writing maintainable, well-tested code.
        </div>
        <div class="skills">
            <h2>Skills</h2>
            <div class="icons">
                {skills.map(skill => (
                    <div class="skill">
                        <Image src={skill.data.image} alt={skill.id} height={size} />
                        <span class="skill_name">{skill.id}</span>
                    </div>
                    
                ))}
            </div>
        </div>
    </div>
    
</Layout>

<style>
    .about {
        display: grid;
        grid-template-rows: 1fr min-content;
        gap: 8px;
    }

    .icons {
        display: flex;
        gap: 8px;
    }

    .skill {
        display: flex;
        height: min-content;
        gap: 2px
    }
</style>