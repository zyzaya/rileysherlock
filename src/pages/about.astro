---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const skills = (await getCollection("skills")).sort(
    (a, b) => a.id.localeCompare(b.id)
)
const size = 24
---
<Layout>
    <div class="about">
        <h1 class="title">Bio</h1>
        <div class="description">
            Hi, I am Riley Sherlock, a full-stack web developer who enjoys building interactive, practical web application and exploring new technologies. I have experience working with Ruby on Rails, JavaScript, React, and TypeScript, with a passion for writing clean, maintainable, and well-tested code.
        </div>
        <div class="skills">
            <h2>Skills</h2>
            <div class="icons">
                {skills.map(skill => (
                    <div class="skill">
                        <Image src={skill.data.image} alt={skill.id} height={size} loading="eager"/>
                        <span class="skill_name">{skill.id}</span>
                    </div>
                ))}
            </div>
        </div>
    </div>
    
</Layout>

<style>
    .about {
        display: grid;
        grid-template-rows: 1fr min-content;
        gap: 8px;
    }

    .icons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    h1, h2 {
        margin-bottom: 8px;
        color: var(--header);
    }

    .skill {
        display: flex;
        height: min-content;
        gap: 4px;
        border: 1px solid rgba(0, 0, 0, 0.24);
        border-radius: 8px;
        padding: 4px;
    }
</style>